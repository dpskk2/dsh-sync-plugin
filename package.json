{
  "name": "dsh-sync-plugin",
  "version": "0.12.3",
  "description": "把 DeepSeek Harness 变成「云文档」:会话、设置、工作区经你自己的 GitHub 私有仓库在多台电脑间双向同步,像云文档一样跨机收敛。冲突按文件类型分层自动合并(会话日志 CRDT 并集、配置字段级 CRDT),零人工裁决;API 密钥不上云。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sync",
    "backup"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpskk2/dsh-sync-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/dpskk2/dsh-sync-plugin/issues"
  },
  "homepage": "https://github.com/dpskk2/dsh-sync-plugin#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
