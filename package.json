{
  "name": "dsh-sync-plugin",
  "version": "0.6.0",
  "description": "DeepSeek Harness 会话同步插件:通过 GitHub 私有仓库在多台电脑间双向同步 DSH 会话,并同步每个会话所属工作区的对应关系(workspace.json)与各工作区真实文件夹内容;冲突时「双边保留」并把冲突呈现给用户抉择(仿 OneNote)。侧栏原生「⟳ 同步」按钮 + 设置「同步/冲突」状态卡。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sync",
    "backup"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpskk2/dsh-sync-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/dpskk2/dsh-sync-plugin/issues"
  },
  "homepage": "https://github.com/dpskk2/dsh-sync-plugin#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
